// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Define your database schema here

model Asset {
  id        String   @id @default(uuid())
  url       String
  key       String
  mimeType  String
  size      Int
  fileName  String
  createdAt DateTime @default(now())
  // Relations
  Posts      Post[]
  UserAvatar User? @relation("UserAvatar")
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  username String @unique
  name     String
  password String?
  salt     String?
  provider String? @default("local") // local, google, github, apple
  providerId String? // ID from the OAuth provider
  createdAt DateTime @default(now())
  // Relations
  avatarId String? @unique
  Avatar   Asset? @relation("UserAvatar", fields: [avatarId], references: [id])
  defaultRourouId String?
  Posts    Post[] 
  Comments Comment[]
  Reacts   Rourou[]
  Followers Follow[] @relation("UserFollowers")
  Following Follow[] @relation("UserFollowing")
  
  @@unique([provider, providerId])
}

model Comment {
  id        String   @id @default(uuid())
  comment   String
  createdAt DateTime @default(now())
  // Relations
  authorId  String
  postId    String
  Author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Rourou {
  id        String   @id @default(uuid())
  name      String
  // put the path url of the rourous in client side in public/
  // url       String
  createdAt DateTime @default(now())
  // Relations
  authorId String
  postId   String
  Author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  Post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Constraint to ensure a user can react on a post with only one rourou
  @@unique([authorId, postId])
}

model Post {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  // Relations
  authorId  String
  Author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  Comments  Comment[]
  Reacts   Rourou[]
  Assets    Asset[]
  // ! faire relation de delete cascade si on supprime un post
}

model Follow {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  // Relations
  followerId  String
  followedId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followed    User     @relation("UserFollowers", fields: [followedId], references: [id], onDelete: Cascade)

  // Constraint to ensure a user cannot follow the same user more than once and cannot follow themselves
  @@unique([followerId, followedId])
}